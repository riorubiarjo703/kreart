# =============================================================================
# kreart — local development (.env.example)
#   cp .env.example .env
#   start the database:  cd ~/Docker/general/kreart && docker compose up -d
#   start the app:       pnpm --filter @kreart/web dev
# =============================================================================

# Postgres — matches ~/Docker/general/kreart/docker-compose.yml (host port 5437)
DATABASE_URI=postgres://root:root@127.0.0.1:5437/kreartdb

# JWT / session encryption — change for anything but local dev
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public app URL (CORS, CSRF)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
